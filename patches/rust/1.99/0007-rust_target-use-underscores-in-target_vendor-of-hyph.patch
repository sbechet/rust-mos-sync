+++ b/compiler/rustc_target/src/spec/targets/mos_atari2600_3e_none.rs
@@ -1,5 +1,5 @@
 use crate::spec::{Target, base};
 
 pub(crate) fn target() -> Target {
-    base::mos::target("atari2600-3e", "mos-atari2600-3e-clang", "MOS 6502X, Atari 2600 (TigerVision 3E)", "mos6502x")
+    base::mos::target("atari2600_3e", "mos-atari2600-3e-clang", "MOS 6502X, Atari 2600 (TigerVision 3E)", "mos6502x")
 }
