 compiler/rustc_target/src/spec/targets/mos_pce_cd_none.rs     | 2 +-
 20 files changed, 22 insertions(+), 20 deletions(-)

diff --git a/compiler/rustc_target/src/spec/base/mos.rs b/compiler/rustc_target/src/spec/base/mos.rs
index 036df2801ae32cdb9a811f64a8d1f00fd0c8ef75..c5f8e0f4c45dc632780a9311334c1513af6e30c1 100644
--- a/compiler/rustc_target/src/spec/base/mos.rs
+++ b/compiler/rustc_target/src/spec/base/mos.rs
@@ -10,7 +10,9 @@
 };
 
 /// A MOS target linked with the SDK driver `linker`; `vendor` is the platform
-/// name exposed as `target_vendor` (e.g. "sim", "c64"), "unknown" for none.
+/// name exposed as `target_vendor` (e.g. "sim", "c64"), "unknown" for none;
+/// hyphens become underscores ("nes_nrom") so the value stays one token for
+/// tools that split on `-`.
 /// `cpu` must match the platform's own `mos-<platform>-clang` default (its
 /// `clang.cfg`, inherited from its SDK `PARENT` platform when it sets none
 /// itself) - most platforms are plain `mos6502`; a few widen the ISA
diff --git a/compiler/rustc_target/src/spec/targets/mos_atari2600_3e_none.rs b/compiler/rustc_target/src/spec/targets/mos_atari2600_3e_none.rs
