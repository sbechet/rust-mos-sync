index 4dcf87e3290a2eeb28cbd9600fa1622006b29716..f2ab607478ab27417f8c4cd39422f949da39bf49 100644
--- a/src/bootstrap/Cargo.toml
+++ b/src/bootstrap/Cargo.toml
@@ -99,3 +99,12 @@ debug = 0
 [profile.dev.package]
 # Only use debuginfo=1 to further reduce compile times.
 bootstrap.debug = 1
+
+# rust-mos-sync: the `cc` crate does not recognize the MOS 6502 architecture
+# (checked against its upstream `main`, 2026-09-27; no issue/PR exists yet),
+# and bootstrap unconditionally probes a C compiler for every configured
+# target (utils/cc_detect.rs), including no_std ones with no C shims. Vendor
+# a copy with one added match arm until this is fixed upstream; see
+# docs/backlog.md in rust-mos-sync.
+[patch.crates-io]
+cc = { path = "cc-mos-vendor" }
