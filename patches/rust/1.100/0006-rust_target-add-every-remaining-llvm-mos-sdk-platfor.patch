diff --git a/compiler/rustc_target/src/spec/base/mos.rs b/compiler/rustc_target/src/spec/base/mos.rs
index 4c6f367189bea7612ef50b60685bc142f9b86eff..036df2801ae32cdb9a811f64a8d1f00fd0c8ef75 100644
--- a/compiler/rustc_target/src/spec/base/mos.rs
+++ b/compiler/rustc_target/src/spec/base/mos.rs
@@ -11,10 +11,16 @@
 
 /// A MOS target linked with the SDK driver `linker`; `vendor` is the platform
 /// name exposed as `target_vendor` (e.g. "sim", "c64"), "unknown" for none.
+/// `cpu` must match the platform's own `mos-<platform>-clang` default (its
+/// `clang.cfg`, inherited from its SDK `PARENT` platform when it sets none
+/// itself) - most platforms are plain `mos6502`; a few widen the ISA
+/// (`mosw65c02`/`mos65c02`/`mos45gs02`/`moshuc6280`/`mos65el02`) or restrict
+/// it to undocumented opcodes only (`mos6502x`, Atari 2600).
 pub(crate) fn target(
     vendor: &'static str,
     linker: &'static str,
     description: &'static str,
+    cpu: &'static str,
 ) -> Target {
     Target {
         llvm_target: "mos-unknown-none".into(),
@@ -30,7 +36,7 @@ pub(crate) fn target(
         options: TargetOptions {
             vendor: vendor.into(),
             c_int_width: 16,
-            cpu: "mos6502".into(),
+            cpu: cpu.into(),
             linker: Some(linker.into()),
             linker_flavor: LinkerFlavor::Gnu(Cc::Yes, Lld::No),
             // The SDK driver adds crt0, libc and the platform linker script.
