@@ -0,0 +1,67 @@
+//! Common definitions for the MOS 65xx targets (llvm-mos backend).
+//!
+//! Code generation happens in rustc with fat LTO (`requires_lto`), then the
+//! llvm-mos SDK Clang driver of the platform (`mos-<platform>-clang`) links
+//! the object with the platform C runtime and linker script.
+
+use crate::spec::{
+    Arch, Cc, LinkerFlavor, Lld, PanicStrategy, RelocModel, Target, TargetMetadata, TargetOptions,
+    cvs,
+};
+
+/// A MOS target linked with the SDK driver `linker`; `vendor` is the platform
+/// name exposed as `target_vendor` (e.g. "sim", "c64"), "unknown" for none.
+pub(crate) fn target(
+    vendor: &'static str,
+    linker: &'static str,
+    description: &'static str,
+) -> Target {
+    Target {
+        llvm_target: "mos-unknown-none".into(),
+        metadata: TargetMetadata {
+            description: Some(description.into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(false),
+        },
+        pointer_width: 16,
+        data_layout: "e-m:e-p:16:8-p1:8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8".into(),
+        arch: Arch::Mos,
+        options: TargetOptions {
+            vendor: vendor.into(),
+            c_int_width: 16,
+            cpu: "mos6502".into(),
+            linker: Some(linker.into()),
+            linker_flavor: LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+            // The SDK driver adds crt0, libc and the platform linker script.
+            no_default_libraries: false,
+            // The zero page and the static stack are allocated for the whole
+            // program at once, which needs a single LLVM module.
+            requires_lto: true,
+            default_codegen_units: Some(1),
+            singlethread: true,
+            max_atomic_width: Some(8),
+            atomic_cas: false,
+            panic_strategy: PanicStrategy::Abort,
+            relocation_model: RelocModel::Static,
+            disable_redzone: true,
+            trap_unreachable: false,
+            emit_debug_gdb_scripts: false,
+            eh_frame_header: false,
+            supports_stack_protector: false,
+            // Code generation flags the llvm-mos Clang driver always passes
+            // (`addMOSCodeGenArgs` in clang/lib/Driver/ToolChains/CommonArgs.cpp).
+            llvm_args: cvs![
+                "--force-precise-rotation-cost",
+                "--jump-inst-cost=6",
+                "--force-loop-cold-block",
+                "--phi-node-folding-threshold=0",
+                "--speculate-blocks=0",
+                "--align-large-globals=false",
+                "--disable-spill-hoist",
+                "--lsr-complexity-limit=10000000",
+            ],
+            ..Default::default()
+        },
+    }
+}
