@@ -0,0 +1,49 @@
+//! MOS 65xx calling convention, as implemented by llvm-mos Clang
+//! (`clang/lib/CodeGen/Targets/MOS.cpp`, `MOSABIInfo`):
+//!
+//! - aggregates larger than 32 bits are passed and returned indirectly;
+//! - smaller aggregates are passed directly; the backend splits them byte by
+//!   byte, so they are coerced here to a sequence of `i8`;
+//! - scalars follow Clang's `DefaultABIInfo` (promotion to `int`, 16 bits).
+
+use rustc_abi::TyAbiInterface;
+
+use crate::callconv::{ArgAbi, FnAbi, Reg, Uniform};
+
+fn classify<'a, Ty, C>(cx: &C, arg: &mut ArgAbi<'a, Ty>, is_ret: bool)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+{
+    if !arg.layout.is_sized() {
+        return;
+    }
+    if !is_ret && arg.layout.pass_indirectly_in_non_rustic_abis(cx) {
+        arg.make_indirect();
+        return;
+    }
+    if arg.layout.is_aggregate() {
+        let total = arg.layout.size;
+        if total.bits() > 32 {
+            arg.make_indirect();
+        } else if total.bytes() > 0 {
+            arg.cast_to(Uniform::new(Reg::i8(), total));
+        }
+    } else {
+        arg.extend_integer_width_to(16);
+    }
+}
+
+pub(crate) fn compute_abi_info<'a, Ty, C>(cx: &C, fty: &mut FnAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+{
+    if !fty.ret.is_ignore() {
+        classify(cx, &mut fty.ret, true);
+    }
+    for arg in fty.args.iter_mut() {
+        if arg.is_ignore() {
+            continue;
+        }
+        classify(cx, arg, false);
+    }
+}
