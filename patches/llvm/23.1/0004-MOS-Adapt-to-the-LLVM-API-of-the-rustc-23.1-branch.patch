diff --git a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
index 1909b0eb95df8ef03e1ce303639c23a7bb440c6e..b5362fa0afb5918dcc6043d4f8255e8ef2443243 100644
--- a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
@@ -255,7 +255,7 @@ MOSLegalizerInfo::MOSLegalizerInfo(const MOSSubtarget &STI) {
   getActionDefinitionsBuilder({G_FSHL, G_FSHR}).lower();
 
   getActionDefinitionsBuilder(
-      {G_CTLZ, G_CTTZ, G_CTPOP, G_CTLZ_ZERO_UNDEF, G_CTTZ_ZERO_UNDEF})
+      {G_CTLZ, G_CTTZ, G_CTPOP, G_CTLZ_ZERO_POISON, G_CTTZ_ZERO_POISON})
       .lower();
 
   // Floating Point Operations
@@ -357,6 +357,8 @@ MOSLegalizerInfo::MOSLegalizerInfo(const MOSSubtarget &STI) {
       .maxScalar(0, S8)
       .unsupported();
 
+  // No type operands, so LLVM <= 22's legacy tables made it legal by default.
+  getActionDefinitionsBuilder(G_BR).alwaysLegal();
   getActionDefinitionsBuilder(G_BRCOND).customFor({S1}).unsupported();
 
   getActionDefinitionsBuilder(G_BRINDIRECT).legalFor({P});
@@ -384,7 +386,6 @@ MOSLegalizerInfo::MOSLegalizerInfo(const MOSSubtarget &STI) {
       .maxScalar(0, S8)
       .unsupported();
 
-  getLegacyLegalizerInfo().computeTables();
   verify(*STI.getInstrInfo());
 }
 
@@ -2000,7 +2001,7 @@ bool MOSLegalizerInfo::legalizeMemOp(LegalizerHelper &Helper,
 
   // Try lowering, keeping in mind the size limit.
   if (IsInline) {
-    Result = Helper.lowerMemcpyInline(MI);
+    Result = Helper.lowerMemCpyFamily(MI);
   } else {
     Result = Helper.lowerMemCpyFamily(MI, SizeLimit);
   }
