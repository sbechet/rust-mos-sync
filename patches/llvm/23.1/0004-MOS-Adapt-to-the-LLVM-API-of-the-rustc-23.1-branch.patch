diff --git a/llvm/lib/Target/MOS/MOSCombiner.cpp b/llvm/lib/Target/MOS/MOSCombiner.cpp
index bff8495ed6115bf69a61f97e9133e86453d38f99..7584dcf872810518a4ba747dd4769025b0a76254 100644
--- a/llvm/lib/Target/MOS/MOSCombiner.cpp
+++ b/llvm/lib/Target/MOS/MOSCombiner.cpp
@@ -753,6 +753,11 @@ void MOSCombiner::getAnalysisUsage(AnalysisUsage &AU) const {
 MOSCombiner::MOSCombiner() : MachineFunctionPass(ID) {
   initializeMOSCombinerPass(*PassRegistry::getPassRegistry());
 
+  // select c, x, 0 -> and c, (freeze x) was added to all_combines in LLVM 23.
+  // Its generated apply code does not check legality, and MOS has no s1 G_AND
+  // (it would be left unselectable after the legalizer).
+  if (!RuleConfig.setRuleDisabled("select_zero_false"))
+    report_fatal_error("select_zero_false is not a rule of this combiner");
   if (!RuleConfig.parseCommandLineOption())
     report_fatal_error("Invalid rule identifier");
 }
