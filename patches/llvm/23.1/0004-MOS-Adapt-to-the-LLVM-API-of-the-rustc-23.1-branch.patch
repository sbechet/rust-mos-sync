diff --git a/llvm/lib/Target/MOS/MOSCombine.td b/llvm/lib/Target/MOS/MOSCombine.td
index 7a064aa3591a4f0fbbe8e0785a41eb0f5f0638d8..a0c46b2a7fb8aa06b19b7c14488a02711a869276 100644
