+const MCPhysReg *
+MOSRegisterInfo::getCalleeSavedRegs(const MachineFunction *MF) const {
+  const MOSFrameLowering &TFI = *getFrameLowering(*MF);
+  return TFI.isISR(*MF) ? MOS_Interrupt_CSR_SaveList : MOS_CSR_SaveList;
+}
