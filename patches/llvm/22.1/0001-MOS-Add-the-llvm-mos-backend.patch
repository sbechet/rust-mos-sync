+//===----------------------------------------------------------------------===//
+/// \file
+/// This file declares semantic analysis functions specific to MOS.
+///
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_SEMA_SEMAMOS_H
+#define LLVM_CLANG_SEMA_SEMAMOS_H
+
+#include "clang/AST/DeclBase.h"
+#include "clang/Sema/SemaBase.h"
