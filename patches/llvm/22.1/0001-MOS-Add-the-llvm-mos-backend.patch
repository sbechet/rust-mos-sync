+# SYMBOL:       foo
+# SYMBOL-NEXT:  ??:0:0
+# SYMBOL-EMPTY:
+# SYMBOL-NEXT:  foo
+# SYMBOL-NEXT:  ??:0:0
+
+.globl foo
+foo:
+  ora #$eaea
+  ldx #$eaea
+  ora #$ea
+  ldx #$ea
